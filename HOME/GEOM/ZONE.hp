%%HP: T(3)A(D)F(.);
\<< 8 FIX CLLCD CLEAR
"    Enter measures   "
1 DISP
"     Then [CONT]     "
2 DISP
"(R=radius, H=height,)"
3 DISP
"(  A=angle in \^odeg  )"
4 DISP 4 WAIT CLLCD
{ STO R H A DONT
MESS UP } MENU
"  Press [SPACE] to   "
2 DISP
"      continue       "
3 DISP HALT { SPHE
CYLI CONE CIRC }
  DO CLLCD
"Press-" 1 DISP 1
WAIT CLLCD
"[A] for Sphere" 1
DISP
"[B] for Cylinder" 2
DISP "[C] for Cone"
3 DISP
"[D] for Circle" 4
DISP
    DO
    UNTIL KEY
    END
  UNTIL { "A" "B"
"C" "D" } SWAP POS
    IF DUP
    THEN 1
    ELSE CLLCD
"You chose poorly" 2
DISP 2000 .1 BEEP
440 .1 BEEP 2 WAIT
    END
  END GET EVAL \>>
