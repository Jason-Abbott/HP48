WAIT { 62.1 63.1
64.1 72.1 73.1 74.1
82.1 83.1 84.1 92.1
93.1 94.1 } SWAP
POS 1 + 'N' STO 9
'R' STO PDATA EVAL
2 DROPN 1 9
  START R ROLL N
GET DUP DUP TYPE
    IF 13 SAME
    THEN DROP OBJ\->
DROP
    ELSE TYPE
      IF 5 SAME
      THEN EVAL '1_
d' CONVERT ROT '1_d
' CONVERT ROT '1_d'
CONVERT + + OBJ\->
DROP
      END
    END \GS+ 'R' DECR
DROP
