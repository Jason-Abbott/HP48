%%HP: T(3)A(D)F(.);
\<< CLLCD
"If you have patience"
1 DISP
"you'll get to see a"
2 DISP
"BEAUTIFUL flower" 3
DISP 3 WAIT CLLCD
"PRETTY           COOL"
1 DISP
"[ON]=Stop        HUH?"
3 DISP DEG 0 360
  FOR a 2 2 a * SIN
* a R\->C P\->R PIXEL 3
  STEP 0 360
  FOR a 1.5 2 a *
COS * a R\->C P\->R
PIXEL 3
  STEP 0 360
  FOR a a SIN a COS
R\->C PIXEL 5
  STEP 0 360
  FOR a a SIN 3 / a
COS 3 / R\->C PIXEL 7
  STEP (1.9,1.1)
PIXEL (1.9,1.2)
PIXEL (1.9,1) PIXEL
(1.9,.6) PIXEL
(2,1.3) PIXEL (2,.9)
PIXEL (2,.7) PIXEL
(2,.5) PIXEL
(2.1,1.2) PIXEL
(2.1,1.1) PIXEL
(2.1,1) PIXEL
(2.1,.9) PIXEL
(2.1,.8) PIXEL
(2.1,.7) PIXEL
(2.1,.6) PIXEL
(2.2,.9) PIXEL
(2.3,1.2) PIXEL
(2.3,1.1) PIXEL
(2.3,1) PIXEL
(2.4,1.3) PIXEL
(2.4,1.1) PIXEL
(2.5,1.2) PIXEL
(2.5,1.1) PIXEL
(2.5,1) PIXEL
(2.6,.9) PIXEL
'PPAR' PURGE \>>
