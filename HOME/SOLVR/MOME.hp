%%HP: T(3)A(D)F(.);
\<< CLLCD
"p: momentum
m: mass
V: velocity
\GDp: change in momentum
\GDt: change in time
F: force
"
1 DISP 3 FREEZE { '
p1i=m1*V1i' 'p2i=m2
*V2i' 'p1f=m1*V1f'
'p2f=m2*V2f' '\GDp=m1
*(V1f-V1i)' 'F=\GDp/
\GDt' 'p1i+p2i=p1f+
p2f' } STEQ MINIT
"" { V1i V2i V1f
V2f p1i p2i p1f p2f
m1 m2 "" "" \GDt \GDp F
} MITM ERAS -62 SF
HALT -62 CF MSOLVR
MOMP \->LCD 3 FREEZE
\>>
