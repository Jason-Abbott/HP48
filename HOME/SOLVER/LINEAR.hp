%%HP: T(3)A(D)F(.);
\<< TEXT CLLCD ERAS
"m: mass
t: time
F: force
W: weight
V: velocity
d: distance
a: acceleration
"
1 DISP 3 FREEZE { '
d=Vi*t+.5*a*t^2' 'd
=(Vf+Vi)*t/2' 'a=(
Vf-Vi)/t' 'Vf^2=Vi^
2+2*a*d' 'F=m*a' 'W
=F' } STEQ MINIT ""
{ Vi Vf a t d "" m
F W } MITM MSOLVR
LIN.P \->LCD 3 FREEZE
\>>
