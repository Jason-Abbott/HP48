%%HP: T(3)A(D)F(.);
\<< CLEAR DEG 'PPAR'
PURGE 1 FIX
  IFERR { { "A" {
    \<< EVAL DUP 'A'
STO 8 (-4.2,1.5)
SUB1
    \>> } } { "B" {
    \<< EVAL DUP 'B'
STO 12 (2.3,1.5)
SUB1
    \>> } } { "C" {
    \<< EVAL DUP 'C'
STO 15 (-.6,-1.5)
SUB1
    \>> } } { "\Gh1" {
    \<< EVAL DUP '\Gh1'
STO 1 (-.6,1.9)
SUB1
    \>> } } { "\Gh2" {
    \<< EVAL DUP '\Gh2'
STO 2 (-2.8,-.5)
SUB1
    \>> } } { "\Gh3" {
    \<< EVAL DUP '\Gh3'
STO 3 (1.6,-.5)
SUB1
    \>> } } } TMENU
GO.1 HALT + + 54 +
CHR 'TRI.' SWAP +
STR\->
    CASE A B + C <
      THEN DOERR
      END A C + B <
      THEN DOERR
      END B C + A <
      THEN DOERR
      END
    END \Gh1 \Gh2 \Gh3 3
\->LIST 'Angles' \->TAG
A B C 3 \->LIST
'Sides' \->TAG \Gh2 SIN
A C * * 2 / 'Area'
\->TAG TRI.P2
(-.6,1.9) \Gh1 \->STR 1
\->GROB GOR
(-2.8,-.5) \Gh2 \->STR
1 \->GROB GOR
(1.6,-.5) \Gh3 \->STR 1
\->GROB GOR
(-4.2,1.5) A \->STR 1
\->GROB GOR (2.3,1.5)
B \->STR 1 \->GROB GOR
(-.6,-1.5) C \->STR 1
\->GROB GOR \->LCD 7
FREEZE { A B C \Gh1
\Gh2 \Gh3 PPAR } PURGE
1 MENU HOME 1 CF
STD
  THEN 1 CF { A B C
\Gh1 \Gh2 \Gh3 PPAR }
PURGE BAD
  END
\>>
